# ============================================================
#  构建环境变量
#
#  用法：cp build.env.example build.env，然后按自己机器的情况改。
#        build.env 已在 .gitignore 里，不会被提交。
# ============================================================

# ---- Android SDK 根目录 ----
# Windows: C:/Users/你的用户名/AppData/Local/Android/Sdk
# macOS  : ~/Library/Android/sdk
# Linux  : ~/Android/Sdk
SDK=C:/Android/Sdk

# ---- build-tools 版本 ----
# 看一眼 $SDK/build-tools/ 下面有哪个目录，填那个名字。
# 太老的版本 aapt2 参数不兼容，建议 33 以上。
BUILD_TOOLS_VERSION=33.0.2

# ---- JDK 根目录 ----
# 需要 JDK 11 或 17。JDK 8 编不了 d8 新版本。
JDK=C:/Program Files/Java/jdk-17

# ---- 签名密钥 ----
# 留空则用 android/app/keystore/wol.jks。
# 这个文件同样在 .gitignore 里。
#KEYSTORE=

# 首次构建时自动生成密钥用的密码。生成之后可以删掉这行，
# 但密码自己要记住 —— 换了密钥就覆盖安装不了。
KEYSTORE_PASS=change_me

KEY_ALIAS=wol

# ---- 输出 ----
#OUT_APK=dist/远程开机.apk

# ---- Go（只打模块时用）----
# 交叉编译中继二进制。源码需要 Go 1.21 以上。
#GO=C:/Go/bin/go.exe
