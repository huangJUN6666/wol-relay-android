# 行尾强制 LF。
# shell 脚本一旦被 Windows 存成 CRLF，刷进 Magisk 后执行会报
# "not found" 或 "syntax error: unexpected end of file"，而且极难查。
*.sh        text eol=lf
*.prop      text eol=lf
*.json      text eol=lf
*.go        text eol=lf
*.java      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.py        text eol=lf
update-binary        text eol=lf
updater-script       text eol=lf

# 二进制资产，不要做任何行尾转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.apk       binary
*.zip       binary
*.jks       binary
